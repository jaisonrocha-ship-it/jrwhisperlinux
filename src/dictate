#!/usr/bin/env python3
"""JRWhisper — ditado por voz local para Linux. Comandos: dictate --help"""
import sys, os

VENV_PYTHON = os.path.expanduser("~/.local/share/dictation-venv/bin/python3")
if sys.executable != VENV_PYTHON and os.path.exists(VENV_PYTHON):
    os.execv(VENV_PYTHON, [VENV_PYTHON, __file__] + sys.argv[1:])

# Pacote ao lado deste arquivo (realpath: ~/.local/bin/dictate costuma ser symlink).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from jrwhisper.cli import main

if __name__ == "__main__":
    main()
