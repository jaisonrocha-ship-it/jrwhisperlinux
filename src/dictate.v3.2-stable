#!/usr/bin/env python3
"""
WhisperFlow para Linux — Ditado por voz com overlay visual e transcrição instantânea
faster-whisper + CUDA/CPU + GTK3 overlay

USO: Super+Shift+V → overlay aparece, fale, resultado é colado automaticamente

v3.2 — 2026-07-03
  • Código limpo livre de comentários internos e estruturado para publicação no GitHub.
  • Interface de 3 linhas deslizantes com fading de opacidade (Pango markup) e altura estática.
  • Suporte híbrido Wayland e X11 (wl-copy, wtype, xclip, xdotool).
  • Isolamento de voz neural integrado com RNNoise via FFmpeg (nice -n 19).
  • Detecção multi-monitor dinâmica baseado na posição do mouse.
  • Daemon Mode com latência zero e tempo de silêncio otimizado para 1.7s.
"""

import sys, os

